# Perplexity API — one key unlocks Sonar, Search, Agent, and Embeddings.
# Generate in the API Portal → API Keys (create an API group first).
PERPLEXITY_API_KEY=pplx-your-key-here

# Anthropic key — only needed for Angle A (Claude calls Perplexity) and the RAG pipeline.
# Angle B (Perplexity Agent → Claude) needs ONLY the Perplexity key above.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: override the model used by agent-to-claude.ts (any id from GET /v1/models)
# PPLX_AGENT_MODEL=anthropic/claude-sonnet-4-6
