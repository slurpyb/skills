{
  "_about": "Citation-grounded marker word banks + a prose-audit (AI-slop) detector bank. Lemmas/patterns are matched case-insensitively; prose_audit regexes encode their own anchoring. Source: Hyland 2005, Biber et al. 1999, Martin & White 2005, Fairclough 1995, plus Wikipedia WikiProject AI Cleanup. Consumed by scan_markers.py.",
  "markers": {
    "hedges": {
      "description": "Tentativeness, epistemic distance, qualified commitment. Weakens claims.",
      "source": "Hyland 2005 Metadiscourse + Biber et al. 1999 LGSWE",
      "lemmas": ["may", "might", "could", "perhaps", "maybe", "possibly", "probably", "presumably", "apparently", "seemingly", "likely", "supposedly", "arguably", "roughly", "approximately", "around", "about", "almost", "nearly", "somewhat", "rather", "fairly", "quite", "broadly", "generally", "tend", "appear", "seem", "suggest", "indicate", "imply", "assume", "believe", "feel", "guess", "reckon", "speculate"],
      "patterns": ["kind of", "sort of", "more or less", "in a sense", "in some sense", "in some ways", "to some extent", "to a degree", "in a way", "I think", "I believe", "I suppose", "I guess", "I'd say", "I would say", "as far as I know", "as far as I can tell", "it seems", "it appears", "it could be", "it might be", "if I'm being honest", "to be fair", "to be honest", "in my view", "from my perspective", "in my opinion"]
    },
    "boosters": {
      "description": "Certainty, conviction, amplified commitment. Strengthens claims.",
      "source": "Hyland 2005 Metadiscourse + Biber et al. 1999 LGSWE",
      "lemmas": ["definitely", "certainly", "clearly", "undoubtedly", "obviously", "evidently", "plainly", "absolutely", "totally", "completely", "actually", "really", "truly", "indeed", "must", "will", "always", "never", "every", "noticeably", "remarkably", "strikingly", "extraordinarily", "incredibly", "demonstrably", "unquestionably", "indisputably", "manifestly", "decidedly", "establish", "demonstrate", "prove", "confirm", "show", "find", "know", "realise", "realize"],
      "patterns": ["of course", "in fact", "without doubt", "without a doubt", "no doubt", "beyond doubt", "beyond question", "it is clear", "it is evident", "the fact is", "the truth is", "the reality is", "there is no question", "make no mistake", "in reality", "in truth", "as a matter of fact"]
    },
    "evidentials_vague": {
      "description": "Authority gestured at without an accountable source. Lends authority without accountability.",
      "source": "Hyland 2005 Metadiscourse + Fairclough 1995 Media Discourse",
      "lemmas": [],
      "patterns": ["studies show", "studies have shown", "studies suggest", "research shows", "research suggests", "research indicates", "research has shown", "experts say", "experts agree", "experts recommend", "experts believe", "scientists say", "scientists believe", "scientists have found", "doctors recommend", "doctors say", "doctors agree", "specialists agree", "specialists recommend", "evidence suggests", "evidence shows", "evidence indicates", "data shows", "data suggests", "data indicates", "sources say", "sources report", "sources confirm", "it has been said", "it is said", "it is believed", "it is thought", "many believe", "many think", "many agree", "many say", "some say", "some argue", "some believe", "people say", "people think", "people believe", "they say", "they tell us", "we are told"]
    },
    "brand_prosody_seed": {
      "description": "Positive-prosody adjectives/nouns of promotional register. When they collocate with a focal entity, the text smuggles evaluation into apparent description (buzzwords/puffery).",
      "source": "PR/marketing corpora + Cook 1992 + Fairclough 1995",
      "lemmas": ["trusted", "proven", "leading", "premier", "top", "innovative", "groundbreaking", "revolutionary", "pioneering", "cutting-edge", "robust", "reliable", "dependable", "solid", "established", "world-class", "first-class", "best-in-class", "industry-leading", "category-leading", "iconic", "legendary", "renowned", "celebrated", "acclaimed", "premium", "luxury", "elite", "exclusive", "prestigious", "expert", "professional", "authoritative", "respected", "definitive", "essential", "indispensable", "unmatched", "unrivalled", "unrivaled", "superior", "exceptional", "outstanding", "remarkable", "extraordinary", "authentic", "genuine", "original", "natural", "pure", "fresh", "wholesome", "honest", "smart", "intelligent", "thoughtful", "considered", "careful", "powerful", "effective", "potent", "high-performance", "high-grade", "convenient", "effortless", "seamless", "smooth", "streamlined", "transformative", "game-changing", "next-generation", "future-proof"],
      "patterns": ["stood the test of time", "has earned its place", "industry standard", "gold standard", "the only choice", "the obvious choice", "trusted by millions", "trusted by thousands", "trusted by experts", "as featured in", "as seen on", "award-winning", "best-selling", "time-honoured", "time-honored", "tried and tested", "tried and true"]
    }
  },
  "prose_audit": {
    "_about": "AI-slop / corporate-prose detectors grounded in Strunk, Orwell, Williams, Pinker + Wikipedia WikiProject AI Cleanup. action = the default fix.",
    "version": "1.1",
    "classes": [
      {"class": "weak_heading", "action": "rewrite as declarative claim", "literals": ["The actual takeaway", "Key takeaways", "Key takeaway", "TL;DR", "TLDR", "The bottom line", "Final thoughts", "Closing thoughts", "Why this matters", "What this means for you", "What this means", "Here's why", "The big picture"]},
      {"class": "hollow_intensifier", "action": "delete or replace with a concrete word", "regex": ["\\b(?:comprehensive|robust|holistic|seamless|cutting[-\\s]edge|state[-\\s]of[-\\s]the[-\\s]art|world[-\\s]class|best[-\\s]in[-\\s]class|next[-\\s]generation|paradigm[-\\s]shifting|game[-\\s]changing|revolutionary)\\b", "\\b(?:leverage|leverages|leveraging|leveraged|utilise|utilises|utilising|utilised|utilize|utilizes|utilizing|utilized|facilitate|facilitates|facilitating|empower|empowers|empowering|empowered|streamline|streamlines|streamlining|optimise|optimises|optimising|optimize|optimizes|optimizing)\\b", "\\bensures?\\b", "\\b(?:delve|delves|delving|delved)\\s+(?:into|deeper)\\b", "\\b(?:meticulous|meticulously|intricate|intricacies|intricately|bolster|bolsters|bolstered|bolstering|garner|garners|garnered|garnering)\\b", "\\b(?:pivotal|crucial|vital|enduring|profound|vibrant)\\b", "\\b(?:nestled|boasts|boasted|boasting)\\b", "\\b(?:testament\\s+to|a\\s+testament|stands\\s+as\\s+a\\s+testament)\\b", "\\b(?:showcase|showcases|showcased|showcasing)\\b", "\\bin\\s+the\\s+(?:heart|midst)\\s+of\\b", "\\b(?:groundbreaking|renowned|esteemed|illustrious|prestigious)\\b"]},
      {"class": "throat_clear_opener", "action": "delete; begin with the subject", "regex": ["(?:^|(?<=[.!?]\\s))(?:Look|Listen|Hey|Okay|OK|Right|So),\\s", "(?:^|(?<=[.!?]\\s))In today'?s\\s+(?:world|fast[-\\s]paced\\s+world|digital\\s+age|landscape|economy|climate)", "(?:^|(?<=[.!?]\\s))(?:Did you know|Have you ever wondered|Imagine if|Picture this|Ever wondered)\\b", "(?:^|(?<=[.!?]\\s))Let'?s\\s+(?:dive in|dive deeper|unpack|break (?:this|it) down|explore|take a look|get into it)", "(?:^|(?<=[.!?]\\s))It'?s\\s+worth\\s+(?:noting|mentioning|considering|pointing out)\\s+that\\b"]},
      {"class": "empty_self_reference", "action": "delete the metadiscourse", "regex": ["\\bIt\\s+is\\s+(?:important|crucial|essential|critical|interesting|worth|noteworthy|notable)\\s+(?:to\\s+(?:note|mention|consider|recognise|recognize|understand|remember|highlight|point out)|that)\\b", "\\bIt\\s+(?:bears|deserves|merits)\\s+(?:mentioning|noting|consideration|highlighting)\\b", "\\bOf\\s+(?:particular|special)\\s+(?:interest|note|importance|relevance)\\s+is\\b", "\\bThis\\s+(?:article|post|piece|essay|section)\\s+(?:will|aims to|seeks to|attempts to|sets out to)\\b"]},
      {"class": "signposting_clutter", "action": "delete or use a natural connective", "regex": ["(?:^|(?<=[.!?]\\s))(?:First(?:ly)?|Second(?:ly)?|Third(?:ly)?|Fourth(?:ly)?|Finally|Lastly),\\s", "(?:^|(?<=[.!?]\\s))(?:Additionally|Furthermore|Moreover|In addition|What'?s more|Beyond that|On top of that),\\s", "(?:^|(?<=[.!?]\\s))(?:That said|Having said that|With that being said|All that said),\\s"]},
      {"class": "generic_close", "action": "delete or write a real conclusion", "regex": ["(?:^|(?<=[.!?]\\s))(?:In\\s+conclusion|To\\s+(?:sum\\s+up|conclude|summarise|summarize|wrap\\s+(?:up|things\\s+up))|To\\s+put\\s+it\\s+(?:simply|plainly|another\\s+way))\\b", "(?:^|(?<=[.!?]\\s))(?:At\\s+the\\s+end\\s+of\\s+the\\s+day|When\\s+all\\s+is\\s+said\\s+and\\s+done|All\\s+things\\s+considered)\\b", "(?:^|(?<=[.!?]\\s))The\\s+(?:bottom\\s+line|takeaway|main\\s+point|key\\s+thing)\\s+is\\b", "(?:^|(?<=[.!?]\\s))So\\s+(?:there\\s+you\\s+have\\s+it|that'?s\\s+the\\s+story)"]},
      {"class": "dialectical_correction", "action": "rewrite as a direct claim", "regex": ["\\bit'?s\\s+not\\s+(?:just\\s+)?[^.,\\u2014\\u2013-]{1,80}[,]?\\s*[\\u2014\\u2013-]\\s*it'?s\\s+[^.]{1,120}", "\\bnot\\s+only\\s+[^.]{1,80}\\s+but\\s+(?:also\\s+)?[^.]{1,120}", "\\bthe\\s+(?:real|actual|true)\\s+(?:move|question|story|point|issue)\\s+(?:is|isn'?t)\\s+[^.]+[\\u2014\\u2013-]"]},
      {"class": "puffery_legacy", "action": "delete or replace with specific evidence", "regex": ["\\b(?:stands?|serves?)\\s+as\\s+a\\s+(?:testament|reminder|symbol|beacon|cornerstone|pillar|hallmark|witness)\\s+(?:to|of)\\b", "\\b(?:marks?|marking|marked|signifies|signifying|represents?|representing)\\s+a\\s+(?:pivotal|significant|crucial|key|turning|defining|watershed|seminal)\\s+(?:moment|point|shift|chapter|era|step)\\b", "\\b(?:reflects?|reflecting)\\s+(?:a\\s+)?(?:broader|wider|larger|growing|emerging)\\s+(?:movement|trend|shift|effort|pattern|trajectory)\\b", "\\bplays?\\s+a\\s+(?:pivotal|crucial|vital|significant|key|central)\\s+role\\s+in\\b"]},
      {"class": "copula_avoidance", "action": "replace with plain is/are", "regex": ["\\b(?:serves?|served|serving)\\s+as\\s+(?:a|the|an)\\s+(?!(?:reminder|warning|backup|substitute|stand[-\\s]in))", "\\b(?:stands?|standing|stood)\\s+as\\s+(?:a|the|an)\\b", "\\b(?:boasts?|boasting|boasted)\\s+(?:a|an|the|over|more\\s+than)\\b", "\\b(?:features?|featuring|featured)\\s+(?:a|an|the)\\s+(?:variety|range|number|host|wealth|plethora)\\b"]},
      {"class": "nominalisation", "action": "restore the verb", "regex": ["\\bthe\\s+(?:implementation|realisation|realization|utilisation|utilization|optimisation|optimization|facilitation|maximisation|prioritisation|conceptualisation)\\s+of\\s+\\w", "\\b(?:make|making)\\s+(?:a\\s+|the\\s+)?(?:decision|determination|assumption|consideration|recommendation|investigation|examination)\\b", "\\b(?:there\\s+is|there\\s+exists?)\\s+a\\s+(?:need|requirement|necessity|tendency|expectation|assumption)\\s+(?:to|for|that)\\b"]},
      {"class": "participial_padding", "action": "delete the trailing -ing phrase", "regex": [",\\s+(?:highlighting|underscoring|emphasising|emphasizing|reflecting|symbolising|symbolizing|contributing|cultivating|fostering|showcasing|demonstrating|illustrating|reinforcing|embodying|capturing)\\s+(?:its|their|the|a)\\s+[^.]{5,160}[.!?]", ",\\s+making\\s+it\\s+a\\s+(?:popular|favourite|favorite|key|crucial|notable|prominent|vital)\\s+[^.]{5,80}[.!?]"]},
      {"class": "false_specificity", "action": "cite a real source or cut", "regex": ["\\b(?:many|most|some|a\\s+lot\\s+of|countless|numerous|various)\\s+(?:people|experts|researchers|studies|scientists|professionals|users)\\b", "\\b(?:studies|research|experts|scientists|professionals|observers|critics|commentators|analysts)\\s+(?:have\\s+shown|suggest|indicate|reveal|demonstrate|believe|agree|confirm|argue|note|claim|maintain)\\b", "\\bit\\s+is\\s+(?:widely|generally|commonly|broadly)\\s+(?:known|believed|accepted|understood|agreed)\\b", "\\b(?:scientifically|clinically|medically|biologically)\\s+(?:proven|shown|established)\\b"]},
      {"class": "em_dash_hedge", "action": "delete the hedge", "regex": ["\\w+\\s+[\\u2014\\u2013]\\s+(?:not|but|though|maybe|perhaps|honestly|admittedly|granted)\\s+\\w"]}
    ]
  }
}
