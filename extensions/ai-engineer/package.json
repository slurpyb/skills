{
  "name": "ai-engineer",
  "version": "1.1.0",
  "description": "AI Engineer orchestration for pi: codegraph orientation, gatherer fan-out, prompt templates, prompt review gate, then task fan-out. Bundles skill-authoring skills and prompt-library templates.",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "pi-package"
  ],
  "scripts": {
    "test": "bun test lib/loop.test.ts lib/templates.test.ts lib/register.test.ts",
    "typecheck": "bunx tsc --noEmit -p tsconfig.json"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ],
    "skills": [
      "skills"
    ],
    "prompts": [
      "instructions"
    ]
  },
  "dependencies": {
    "typebox": "latest"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "latest",
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^6"
  }
}
