# Jina AI × Claude environment variables
# Copy to .env and fill in. Load with `node --env-file=.env <file>.ts` (Node 20+),
# or `import 'dotenv/config'` on Node < 20.

# Jina API key — one key for all Jina services (Reader, Search, Embeddings, Reranker,
# Classifier, Segmenter, DeepSearch, Batch). Get it at jina.ai/api-dashboard/key-manager
JINA_API_KEY=jina_your_key

# Anthropic (Claude) API key — https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_key
