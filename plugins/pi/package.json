{
  "name": "@slurpyb/pi-harness",
  "version": "0.1.0",
  "description": "Skills, prompt templates, instructions, and validation for configuring and building with the Pi coding harness.",
  "keywords": [
    "pi-package",
    "agent-skills",
    "pi",
    "coding-agent",
    "prompt-templates"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/slurpyb/skills.git",
    "directory": "plugins/pi"
  },
  "scripts": {
    "validate": "python3 scripts/validate-pi-harness.py .",
    "smoke": "python3 scripts/smoke-pi-resources.py .",
    "test": "python3 -m unittest discover -s tests -p 'test_*.py'"
  },
  "pi": {
    "skills": [
      "./skills"
    ],
    "prompts": [
      "./prompts"
    ]
  }
}
